PORT=5000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auth_demo
# Enable only when your provider supports/requires MySQL TLS.
DB_SSL=false
# Optional CA file path supplied by your database provider
DB_SSL_CA_FILE=
# Set to 1 behind a single trusted hosting reverse proxy; local default is 0.
TRUST_PROXY=0
